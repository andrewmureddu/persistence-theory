---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import { getProjectTrackerSnapshot } from '../lib/projectTracker';

const tracker = await getProjectTrackerSnapshot();
const fronts = tracker.activeFronts;
const openProblems = tracker.openProblems.slice(0, 8);
const recentChanges = tracker.recentChanges.slice(0, 4);
const heroActions = [
	{ href: '/library', label: 'Open the library', primary: true },
	{ href: '/theory', label: 'Return to the theory', primary: true },
	{ href: '/', label: 'Go to the overview' },
];

const workspace = [
	['paper/', 'The active manuscript spine.'],
	['proofs/', 'Core theorem chain and standalone proof documents.'],
	['reductions/', 'Formal special-case derivations across literatures.'],
	['bridges/', 'Empirical, operator, arithmetic, and subsystem interfaces.'],
	['research/', 'Literature surveys, synthesis notes, and cross-domain scaffolding.'],
	['simulations/', 'Empirical prototypes, calibration helpers, and experiment notes.'],
	[
		'special_cases/',
		'Current workspace folder for the public-facing laws track and the extended structural-law catalog.',
	],
	['essays/', 'Interpretive and philosophical companion writing.'],
	['audits/', 'Integrity audits and packaging checks.'],
	['sessions/', 'Session-by-session research log.'],
];
---

<Layout
	title="Adaptive Coherence Principle | Program"
	description="Current status, active fronts, open problems, and workspace structure for the Adaptive Coherence Principle formalization program."
>
	<PageHero
		eyebrow="Program status"
		title="Where the project stands right now."
		asideTitle="Snapshot"
		actions={heroActions}
	>
		<p slot="copy">
			The formalization workspace is already functioning like a live research
			program: active paper, proof archive, bridge documents, open-problem tracker,
			and session log. This page turns that internal structure into a public map.
		</p>

		<div slot="sidebar" class="dense">
			<div>
				<strong>Last updated</strong>
				<p>{tracker.lastUpdated}</p>
			</div>
			<div>
				<strong>Active paper</strong>
				<p>
					<code>{tracker.activePaperPath}</code>
					{tracker.activePaperMasthead && ` with internal masthead ${tracker.activePaperVersion}`}
				</p>
			</div>
			<div>
				<strong>Lead front</strong>
				<p>{fronts[0]?.title ?? 'See STATUS.md for the current lead front.'}</p>
			</div>
			<div>
				<strong>Open problems</strong>
				<p>{tracker.openProblemCount} currently tracked in <code>OPEN_PROBLEMS.md</code>.</p>
			</div>
		</div>
	</PageHero>

	<section class="section">
		<div class="tracker-callout license-callout">
			<div>
				<strong>Read the live tracker at the source.</strong>
				<p>
					<code>/program</code> now reflects <code>STATUS.md</code> and <code>OPEN_PROBLEMS.md</code>,
					but the canonical research state still lives in those tracker documents.
				</p>
			</div>

			<div class="tracker-actions">
				<a class="button primary" href="/library/project/status">Open STATUS</a>
				<a class="button" href="/library/project/open-problems">Open Problems</a>
			</div>
		</div>
	</section>

	<section class="section">
		<SectionHead
			kicker="Active fronts"
			title="The work is beyond the “just prove it” phase"
			intro="The core proof spine is already substantial. The current frontier is about sharpening, testing, packaging, and extending the theory."
		/>

		<div class="card-grid">
			{
				fronts.map((front) => (
					<article class="card front-card">
						<div class="front-meta">
							<span class="tag">Front {front.index}</span>
							{
								front.priority && (
									<span class="tag">
										Priority: {front.priority.split('—')[0].trim()}
									</span>
								)
							}
						</div>
						<h3>{front.title}</h3>
						<p>{front.summary}</p>
					</article>
				))
			}
		</div>
	</section>

	<section class="section">
		<div class="pillars">
			<article class="callout">
				<strong>Open problems still worth watching</strong>
				<ul class="mini-list">
					{
						openProblems.map((problem) => (
							<li>
								<strong>{problem.id}</strong> - {problem.title}
							</li>
						))
					}
				</ul>
				<p class="subtle">
					Showing {openProblems.length} of {tracker.openProblemCount}. The full tracker
					lives in <a href="/library/project/open-problems">Open Problems</a>.
				</p>
			</article>

			<article class="callout">
				<strong>Recent momentum</strong>
				<ul class="mini-list">
					{
						recentChanges.map((change) => (
							<li>
								<strong>{change.date}</strong> - {change.title}
							</li>
						))
					}
				</ul>
				<p class="subtle">
					This list is pulled from the live <a href="/library/project/status">STATUS changelog</a>.
				</p>
			</article>
		</div>
	</section>

	<section class="section">
		<SectionHead
			kicker="Workspace map"
			title="How the formalization is organized"
		/>

		<div class="timeline">
			{
				workspace.map(([path, copy]) => (
					<article class="timeline-item">
						<h3><code>{path}</code></h3>
						<p>{copy}</p>
					</article>
				))
			}
		</div>
	</section>

	<section class="section">
		<div class="strip">
			<p>
				The site can now grow in two directions: publishing selected research content
				as native pages, or adding search, diagrams, and interactive visualizations
				for the productive interval, drift, and subsystem coordination stories.
			</p>
			<a class="button primary" href="/library">Continue into the library</a>
		</div>
	</section>
</Layout>

<style>
	.tracker-callout {
		gap: 1.25rem;
	}

	.tracker-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
	}

	.front-card {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}

	.front-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
	}

	.front-card :global(.tag) {
		margin-bottom: 0;
	}

	@media (max-width: 720px) {
		.tracker-callout {
			flex-direction: column;
			align-items: stretch;
		}

		.tracker-actions {
			width: 100%;
		}
	}
</style>
