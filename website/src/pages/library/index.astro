---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import { getLibraryEntries, getSectionList, getSectionEntries } from '../../lib/library';

const sections = getSectionList();
const allEntries = await getLibraryEntries();
const heroActions = [
	{ href: '/library/paper/acp_main_v10', label: 'Open the paper', primary: true },
	{ href: '/library/essays', label: 'Browse essays' },
];
const featuredSections = await Promise.all(
	sections.map(async (section) => ({
		...section,
		entries: (await getSectionEntries(section.key)).slice(0, 3),
	})),
);

function sectionHref(entries: Awaited<(typeof featuredSections)>[number]['entries'], key: string) {
	return entries.length === 1 ? entries[0].path : `/library/${key}`;
}

function sectionTag(entries: Awaited<(typeof featuredSections)>[number]['entries']) {
	if (entries.length === 1) {
		return '1 document';
	}

	return `${entries.length} featured`;
}
---

<Layout
	title="Persistence Theory | Library"
	description="Browse the paper, proofs, reductions, bridges, research notes, simulations, essays, audits, and session notes from the Persistence Theory workspace."
>
	<PageHero
		eyebrow="Library"
		title="The project corpus, readable on the site."
		asideTitle="How to use it"
		actions={heroActions}
		stats={[
			{ value: `${allEntries.length}`, label: 'Readable documents' },
			{ value: `${sections.length}`, label: 'Sections in the library' },
			{ value: 'Live', label: 'Rendered from the workspace source' },
		]}
	>
		<p slot="copy">
			This library turns the formalization workspace into a browsable reading
			interface. The source files still live in <code>Formalization/</code>, but the
			site now exposes them as a navigable corpus instead of a static summary.
		</p>

		<p slot="sidebar">
			Start with the paper if you want the spine, proofs if you want the theorem
			chain, reductions if you want the unification argument, research if you want the
			external literature map, simulations if you want the empirical layer, and essays
			if you want the wider philosophical register.
		</p>
		<div slot="sidebar" class="dense">
			<div>
				<strong>Best entry point</strong>
				<p>The paper and project docs establish the vocabulary before the deeper branches split.</p>
			</div>
			<div>
				<strong>Most technical track</strong>
				<p>Proofs, bridges, and reductions carry the densest formal argument.</p>
			</div>
		</div>
	</PageHero>

	<section class="section">
		<div class="license-callout">
			<div>
				<strong>CC0 applies to the project.</strong>
				<p>
					Read freely, reuse freely, and take any useful insight into your own work
					without waiting on permissions.
				</p>
			</div>
			<a class="button primary" href="/cc0">Read the CC0 note</a>
		</div>
	</section>

	<section class="section">
		<SectionHead
			kicker="Browse by section"
			title="A reading surface for the whole program"
		/>

		<div class="card-grid">
			{
				featuredSections.map((section) => (
					<article class="card">
						<span class="tag">{sectionTag(section.entries)}</span>
						<h3>
							<a href={sectionHref(section.entries, section.key)}>{section.label}</a>
						</h3>
						<p>{section.description}</p>
						<ul class="mini-list">
							{section.entries.map((entry) => <li><a href={entry.path}>{entry.title}</a></li>)}
						</ul>
					</article>
				))
			}
		</div>
	</section>
</Layout>
