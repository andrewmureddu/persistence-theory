---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Adaptive Coherence Principle',
	description = 'A public-facing research site for the Adaptive Coherence Principle.',
} = Astro.props;

const pathname = Astro.url.pathname;
const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/library', label: 'Library' },
	{ href: '/presentations', label: 'Presentations' },
	{ href: '/theory', label: 'Theory' },
	{ href: '/program', label: 'Program' },
];

function isActiveNavLink(href: string) {
	if (href === '/') {
		return pathname === '/';
	}

	return pathname === href || pathname.startsWith(`${href}/`);
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<div class="page-shell">
			<div class="ambient ambient-a"></div>
			<div class="ambient ambient-b"></div>
			<div class="ambient ambient-c"></div>

			<header class="site-header">
				<a class="brand" href="/">
					<span class="brand-mark">ACP</span>
					<span class="brand-copy">
						<strong>Adaptive Coherence Principle</strong>
						<small>Persistence through coherent openness</small>
					</span>
				</a>

				<nav class="site-nav" aria-label="Primary">
					{
						navLinks.map((link) => (
							<a
								href={link.href}
								class:list={[
									'nav-link',
									{ active: isActiveNavLink(link.href) },
								]}
							>
								{link.label}
							</a>
						))
					}
				</nav>
			</header>

			<main class="page">
				<slot />
			</main>

			<footer class="site-footer">
				<div class="footer-block">
					<p>Built as the public layer for the ongoing ACP formalization workspace.</p>
					<p>
						Working draft status: April 2026. Source research remains in the
						<code>Formalization/</code> workspace.
					</p>
				</div>

				<div class="footer-block footer-license">
					<a class="cc0-stamp" href="/cc0">
						<span class="cc0-mark">CC0</span>
						<span class="cc0-copy">
							<strong>No strings attached</strong>
							<small>Take the ideas, remix them, build with them.</small>
						</span>
					</a>
				</div>
			</footer>
		</div>
	</body>
</html>

<style>
	:root {
		--bg: #07131d;
		--bg-soft: #0f2331;
		--surface: rgba(13, 27, 38, 0.78);
		--surface-strong: rgba(9, 19, 28, 0.92);
		--surface-border: rgba(183, 211, 219, 0.14);
		--ink: #f4efe1;
		--muted: #a7b9bf;
		--accent: #f2b35d;
		--accent-strong: #ea7c51;
		--accent-cool: #73b8bf;
		--accent-pale: #f4d7a1;
		--shadow: 0 28px 80px rgba(0, 0, 0, 0.28);
		--radius-lg: 28px;
		--radius-md: 18px;
		--content-width: min(1120px, calc(100vw - 2rem));
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		min-width: 320px;
		min-height: 100vh;
		color: var(--ink);
		background:
			radial-gradient(circle at top left, rgba(234, 124, 81, 0.16), transparent 28%),
			radial-gradient(circle at 85% 14%, rgba(115, 184, 191, 0.16), transparent 22%),
			linear-gradient(180deg, #081520 0%, #07131d 52%, #050d14 100%);
		font-family: 'Avenir Next', 'Segoe UI', 'Helvetica Neue', sans-serif;
		line-height: 1.6;
	}

	body::before {
		content: '';
		position: fixed;
		inset: 0;
		pointer-events: none;
		background-image:
			linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
		background-size: 72px 72px;
		mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.35), transparent 82%);
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	code {
		font-family: 'SFMono-Regular', 'Menlo', 'Monaco', 'Courier New', monospace;
		font-size: 0.92em;
	}

	.page-shell {
		position: relative;
		min-height: 100vh;
		overflow: hidden;
	}

	.ambient {
		position: fixed;
		border-radius: 999px;
		filter: blur(22px);
		opacity: 0.45;
		pointer-events: none;
	}

	.ambient-a {
		top: 7rem;
		left: -8rem;
		width: 18rem;
		height: 18rem;
		background: rgba(234, 124, 81, 0.18);
	}

	.ambient-b {
		top: 28rem;
		right: -5rem;
		width: 16rem;
		height: 16rem;
		background: rgba(115, 184, 191, 0.2);
	}

	.ambient-c {
		bottom: 10rem;
		left: 35%;
		width: 12rem;
		height: 12rem;
		background: rgba(242, 179, 93, 0.12);
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		width: var(--content-width);
		margin: 0 auto;
		padding: 1rem 0 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.site-header::before {
		content: '';
		position: absolute;
		inset: 0;
		background: rgba(6, 13, 19, 0.52);
		backdrop-filter: blur(16px);
		border: 1px solid rgba(255, 255, 255, 0.04);
		border-radius: 999px;
		z-index: -1;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.9rem;
		padding: 0.85rem 1.15rem;
	}

	.brand-mark {
		display: grid;
		place-items: center;
		width: 2.55rem;
		height: 2.55rem;
		border-radius: 50%;
		background: linear-gradient(135deg, var(--accent) 0%, var(--accent-strong) 100%);
		color: #0a1218;
		font-weight: 800;
		font-size: 0.82rem;
		letter-spacing: 0;
	}

	.brand-copy {
		display: flex;
		flex-direction: column;
		line-height: 1.15;
	}

	.brand-copy strong,
		h1,
		h2,
		h3 {
		font-family: 'Iowan Old Style', 'Palatino Linotype', 'Book Antiqua', Georgia, serif;
		font-weight: 600;
		letter-spacing: 0;
	}

	.brand-copy small {
		color: var(--muted);
		font-size: 0.82rem;
		margin-top: 0.18rem;
	}

	.site-nav {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.45rem;
	}

	.nav-link {
		padding: 0.72rem 0.95rem;
		border-radius: 999px;
		color: var(--muted);
		transition:
			background-color 180ms ease,
			color 180ms ease,
			transform 180ms ease;
	}

	.nav-link:hover,
	.nav-link:focus-visible {
		color: var(--ink);
		background: rgba(255, 255, 255, 0.06);
		transform: translateY(-1px);
	}

	.nav-link.active {
		color: #081520;
		background: linear-gradient(135deg, var(--accent-pale), var(--accent));
	}

	.page {
		width: var(--content-width);
		margin: 0 auto;
		padding: 2.2rem 0 5rem;
	}

	.site-footer {
		width: var(--content-width);
		margin: 0 auto;
		padding: 0 0 3rem;
		color: var(--muted);
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		font-size: 0.95rem;
	}

	.footer-block {
		display: grid;
		gap: 0.25rem;
	}

	.footer-license {
		justify-items: end;
	}

	.cc0-stamp {
		display: inline-flex;
		align-items: center;
		gap: 0.8rem;
		padding: 0.75rem 1rem;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.08);
		transition:
			transform 180ms ease,
			background-color 180ms ease,
			border-color 180ms ease;
	}

	.cc0-stamp:hover,
	.cc0-stamp:focus-visible {
		transform: translateY(-1px);
		background: rgba(255, 255, 255, 0.08);
		border-color: rgba(255, 255, 255, 0.14);
	}

	.cc0-mark {
		display: grid;
		place-items: center;
		min-width: 3.1rem;
		height: 3.1rem;
		padding: 0 0.6rem;
		border-radius: 50%;
		background: linear-gradient(135deg, var(--accent-pale), var(--accent));
		color: #081520;
		font-weight: 800;
		letter-spacing: 0;
	}

	.cc0-copy {
		display: grid;
		gap: 0.05rem;
	}

	.cc0-copy strong {
		color: var(--ink);
		font-size: 0.94rem;
	}

	.cc0-copy small {
		color: var(--muted);
		font-size: 0.8rem;
	}

	:global(.hero) {
		padding: 4.6rem 0 2.5rem;
		display: grid;
		grid-template-columns: minmax(0, 1.45fr) minmax(280px, 0.75fr);
		gap: 1.5rem;
		align-items: stretch;
	}

	:global(.hero-copy),
	:global(.hero-panel),
	:global(.section-card),
	:global(.card),
	:global(.callout),
	:global(.strip),
	:global(.pillar),
	:global(.timeline-item) {
		background: linear-gradient(180deg, rgba(15, 35, 49, 0.92), rgba(8, 19, 29, 0.9));
		border: 1px solid var(--surface-border);
		box-shadow: var(--shadow);
		backdrop-filter: blur(14px);
	}

	:global(.hero-copy),
	:global(.hero-panel) {
		border-radius: var(--radius-lg);
		padding: 1.5rem;
		animation: rise 700ms ease both;
	}

	:global(.hero-copy) {
		padding: 2rem;
	}

	:global(.eyebrow) {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.32rem 0.72rem;
		border-radius: 999px;
		color: var(--accent-pale);
		background: rgba(242, 179, 93, 0.12);
		border: 1px solid rgba(242, 179, 93, 0.18);
		font-size: 0.82rem;
		text-transform: uppercase;
		letter-spacing: 0;
	}

	:global(.hero h1) {
		margin: 1rem 0 1rem;
		font-size: clamp(2.9rem, 6vw, 5.4rem);
		line-height: 0.92;
		max-width: 10ch;
	}

	:global(.hero p) {
		margin: 0;
		font-size: 1.08rem;
		color: var(--muted);
		max-width: 62ch;
	}

	:global(.button-row) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		margin-top: 1.6rem;
	}

	:global(.button) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.92rem 1.2rem;
		border-radius: 999px;
		border: 1px solid rgba(255, 255, 255, 0.1);
		background: rgba(255, 255, 255, 0.03);
		transition:
			transform 180ms ease,
			background-color 180ms ease,
			border-color 180ms ease;
	}

	:global(.button:hover),
	:global(.button:focus-visible) {
		transform: translateY(-1px);
		background: rgba(255, 255, 255, 0.08);
		border-color: rgba(255, 255, 255, 0.18);
	}

	:global(.button.primary) {
		background: linear-gradient(135deg, var(--accent-pale), var(--accent));
		color: #081520;
		border-color: transparent;
		font-weight: 700;
	}

	:global(.stat-grid),
	:global(.card-grid),
	:global(.pillar-grid),
	:global(.timeline) {
		display: grid;
		gap: 1rem;
	}

	:global(.stat-grid) {
		margin-top: 1.4rem;
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	:global(.stat) {
		padding: 1rem;
		border-radius: var(--radius-md);
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.08);
	}

	:global(.stat strong) {
		display: block;
		font-size: 1.7rem;
		font-family: 'Iowan Old Style', 'Palatino Linotype', 'Book Antiqua', Georgia, serif;
	}

	:global(.stat span) {
		color: var(--muted);
		font-size: 0.95rem;
	}

	:global(.hero-panel h2),
	:global(.section-title),
	:global(.card h3),
	:global(.pillar h3),
	:global(.timeline-item h3) {
		margin: 0 0 0.7rem;
		font-size: clamp(1.45rem, 3vw, 2rem);
	}

	:global(.hero-panel p),
	:global(.hero-panel li),
	:global(.card p),
	:global(.pillar p),
	:global(.timeline-item p),
	:global(.section-intro) {
		color: var(--muted);
	}

	:global(.section) {
		padding: 1.25rem 0;
		animation: rise 800ms ease both;
	}

	:global(.section-head) {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin-bottom: 1.1rem;
	}

	:global(.section-kicker) {
		color: var(--accent-cool);
		text-transform: uppercase;
		letter-spacing: 0;
		font-size: 0.8rem;
	}

	:global(.section-title) {
		font-size: clamp(2rem, 4vw, 3rem);
	}

	:global(.card-grid) {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	:global(.card),
	:global(.pillar),
	:global(.timeline-item),
	:global(.callout),
	:global(.strip) {
		border-radius: var(--radius-md);
		padding: 1.2rem;
	}

	:global(.card .tag),
	:global(.pill) {
		display: inline-flex;
		align-items: center;
		padding: 0.22rem 0.62rem;
		border-radius: 999px;
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0;
		margin-bottom: 0.7rem;
		background: rgba(255, 255, 255, 0.06);
		color: var(--accent-pale);
	}

	:global(.interval-grid),
	:global(.split-grid) {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	:global(.interval-card) {
		position: relative;
		padding: 1.35rem;
		border-radius: var(--radius-lg);
		border: 1px solid var(--surface-border);
		background: rgba(6, 14, 20, 0.78);
		overflow: hidden;
	}

	:global(.interval-card::after) {
		content: '';
		position: absolute;
		inset: auto 1.2rem 1rem 1.2rem;
		height: 3px;
		border-radius: 999px;
		background: linear-gradient(90deg, rgba(255, 255, 255, 0.14), transparent);
	}

	:global(.interval-card.featured) {
		background:
			linear-gradient(180deg, rgba(22, 55, 63, 0.94), rgba(10, 24, 31, 0.96)),
			radial-gradient(circle at top, rgba(115, 184, 191, 0.16), transparent 50%);
		transform: translateY(-0.3rem);
	}

	:global(.interval-card h3) {
		margin: 0 0 0.6rem;
		font-size: 1.45rem;
	}

	:global(.mini-list) {
		margin: 0;
		padding-left: 1.1rem;
		color: var(--muted);
	}

	:global(.mini-list li + li) {
		margin-top: 0.45rem;
	}

	:global(.pillars) {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 1rem;
	}

	:global(.callout strong) {
		display: block;
		margin-bottom: 0.35rem;
		font-size: 1.15rem;
	}

	:global(.strip) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	:global(.license-callout) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem 1.15rem;
		border-radius: var(--radius-md);
		background:
			linear-gradient(180deg, rgba(20, 46, 56, 0.94), rgba(9, 21, 29, 0.94)),
			radial-gradient(circle at top left, rgba(242, 179, 93, 0.14), transparent 50%);
		border: 1px solid rgba(242, 179, 93, 0.18);
		box-shadow: var(--shadow);
	}

	:global(.license-callout strong) {
		display: block;
		margin-bottom: 0.18rem;
		color: var(--ink);
	}

	:global(.license-callout p) {
		margin: 0;
		color: var(--muted);
	}

	:global(.license-callout .button) {
		flex-shrink: 0;
	}

	:global(.strip p) {
		margin: 0;
	}

	:global(.timeline) {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	:global(.timeline-item) {
		position: relative;
		padding-left: 1.4rem;
	}

	:global(.timeline-item::before) {
		content: '';
		position: absolute;
		left: 0;
		top: 1.4rem;
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: linear-gradient(135deg, var(--accent), var(--accent-strong));
	}

	:global(.timeline-item p:last-child),
	:global(.card p:last-child),
	:global(.pillar p:last-child),
	:global(.callout p:last-child) {
		margin-bottom: 0;
	}

	:global(.dense) {
		display: grid;
		gap: 0.65rem;
	}

	:global(.dense strong) {
		font-size: 1rem;
	}

	:global(.subtle) {
		color: var(--muted);
	}

	:global(.quote) {
		padding: 1.35rem;
		border-left: 3px solid var(--accent);
		background: rgba(255, 255, 255, 0.03);
		border-radius: 0 var(--radius-md) var(--radius-md) 0;
		color: var(--accent-pale);
		font-size: 1.05rem;
	}

	:global(.document-list) {
		display: grid;
		gap: 1rem;
	}

	:global(.document-card),
	:global(.doc-frame),
	:global(.sidebar-card) {
		background: linear-gradient(180deg, rgba(15, 35, 49, 0.92), rgba(8, 19, 29, 0.9));
		border: 1px solid var(--surface-border);
		box-shadow: var(--shadow);
		backdrop-filter: blur(14px);
	}

	:global(.document-card) {
		padding: 1.2rem;
		border-radius: var(--radius-md);
	}

	:global(.document-card h2) {
		margin: 0 0 0.5rem;
		font-size: 1.4rem;
	}

	:global(.doc-meta),
	:global(.doc-breadcrumb),
	:global(.doc-actions) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		align-items: center;
		color: var(--muted);
		font-size: 0.92rem;
	}

	:global(.doc-actions code),
	:global(.doc-breadcrumb),
	:global(.doc-meta span),
	:global(.doc-meta code) {
		overflow-wrap: anywhere;
		word-break: break-word;
	}

	:global(.doc-meta) {
		justify-content: space-between;
		margin-top: 1rem;
	}

	:global(.doc-shell) {
		padding: 3.5rem 0 1rem;
	}

	:global(.doc-frame) {
		border-radius: var(--radius-lg);
		padding: 1.6rem;
		overflow: hidden;
		min-width: 0;
	}

	:global(.doc-header) {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.4rem;
	}

	:global(.doc-header h1) {
		margin: 0.5rem 0 0.5rem;
		font-size: clamp(2.2rem, 5vw, 4rem);
		line-height: 0.95;
		max-width: 12ch;
	}

	:global(.doc-summary) {
		margin: 0;
		color: var(--muted);
		max-width: 64ch;
	}

	:global(.doc-layout) {
		display: grid;
		grid-template-columns: minmax(0, 1.65fr) minmax(240px, 0.6fr);
		gap: 1rem;
		align-items: start;
		min-width: 0;
	}

	:global(.doc-sidebar) {
		display: grid;
		gap: 1rem;
		position: sticky;
		top: 6.5rem;
	}

	:global(.sidebar-card) {
		padding: 1rem;
		border-radius: var(--radius-md);
	}

	:global(.sidebar-card strong) {
		display: block;
		margin-bottom: 0.6rem;
	}

	:global(.doc-prose) {
		padding: 1.7rem;
		border-radius: var(--radius-lg);
		background: rgba(248, 241, 228, 0.98);
		color: #18242c;
		font-size: 1.04rem;
		line-height: 1.78;
		overflow-wrap: anywhere;
		word-break: normal;
		hyphens: auto;
		min-width: 0;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
	}

	:global(.doc-prose > *) {
		max-width: 100%;
		min-width: 0;
	}

	:global(.doc-prose h1),
	:global(.doc-prose h2),
	:global(.doc-prose h3),
	:global(.doc-prose h4) {
		color: #0d1d28;
		scroll-margin-top: 7rem;
		line-height: 1.08;
		text-wrap: balance;
	}

	:global(.doc-prose h1) {
		font-size: clamp(2rem, 5vw, 3rem);
	}

	:global(.doc-prose h2) {
		font-size: clamp(1.6rem, 4vw, 2.25rem);
		margin-top: 2.2rem;
	}

	:global(.doc-prose h3) {
		font-size: clamp(1.28rem, 3vw, 1.7rem);
